{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VEIN Mod Manifest",
  "description": "Metadata format for VEIN mods. Runtime behavior is not implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "author",
    "version",
    "description",
    "gameVersion",
    "frameworkVersion",
    "dependencies",
    "optionalDependencies",
    "loadBefore",
    "loadAfter",
    "conflicts",
    "entryPoint"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier used to refer to this mod."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of this mod."
    },
    "description": {
      "type": "string"
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Target game version or version notation."
    },
    "frameworkVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Required framework version or version notation."
    },
    "dependencies": {
      "$ref": "#/$defs/dependencyList"
    },
    "optionalDependencies": {
      "$ref": "#/$defs/dependencyList"
    },
    "loadBefore": {
      "$ref": "#/$defs/modIdList",
      "description": "Mod IDs that should load after this mod."
    },
    "loadAfter": {
      "$ref": "#/$defs/modIdList",
      "description": "Mod IDs that should load before this mod."
    },
    "conflicts": {
      "$ref": "#/$defs/modIdList"
    },
    "entryPoint": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Reserved for a future runtime entry point; null means none is declared."
    }
  },
  "$defs": {
    "modIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencyList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "versionRange"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "versionRange": {
            "type": "string",
            "minLength": 1,
            "description": "Version constraint for the referenced mod."
          }
        }
      }
    }
  }
}
